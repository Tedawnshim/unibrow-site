---
import logo from '../assets/brand/unibrow-studio-logo.svg';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href)) || (href === '/portfolio/' && path.startsWith('/project/'));
---
<header class="site-header">
  <div class="wrap site-header__bar">
    <a href="/" class="site-header__logo" aria-label="Unibrow Studio, home">
      <img src={logo.src} width="64" height="64" alt="Unibrow Studio" />
    </a>

    <nav class="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--blue" href="/contact/">Start a project</a>
      <a class="btn btn--line site-header__wa" href={site.whatsapp}>WhatsApp</a>
    </div>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Menu</span>
      <span class="menu-btn__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  <div class="mobile-menu on-blue" id="mobile-menu" hidden>
    <nav aria-label="Main, mobile">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/contact/">Contact</a>
    </nav>
    <div class="mobile-menu__actions">
      <a class="btn btn--light" href="/contact/">Start a project</a>
      <a class="btn btn--light-line" href={site.whatsapp}>WhatsApp us</a>
      <p class="small">{site.phoneDisplay} · {site.email}</p>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--primary); border-bottom: var(--line); }
  .site-header__bar { display: flex; align-items: center; gap: 16px 32px; min-height: 84px; padding-block: 10px; }
  .site-header__logo { display: block; flex: none; }
  .site-header__logo img { width: 64px; height: 64px; }
  .site-nav { display: none; gap: 28px; margin-left: auto; }
  .site-nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 12px 0; border-bottom: 2px solid transparent; }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--structure); border-bottom-color: var(--structure); }
  .site-header__actions { display: none; gap: 10px; }
  .menu-btn {
    margin-left: auto; width: 48px; height: 48px; border: var(--line); background: var(--primary); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .menu-btn__bars { display: flex; flex-direction: column; gap: 5px; }
  .menu-btn__bars i { display: block; width: 22px; height: 2px; background: var(--ink); transition: transform .2s, opacity .2s; }
  .menu-btn[aria-expanded='true'] .menu-btn__bars i:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-btn__bars i:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] .menu-btn__bars i:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { position: fixed; inset: 85px 0 0 0; overflow-y: auto; padding: 24px var(--gutter) 32px; display: flex; flex-direction: column; gap: 32px; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu nav { display: flex; flex-direction: column; }
  .mobile-menu nav a { font-family: var(--font-display); font-size: 48px; line-height: 1.2; text-transform: uppercase; text-decoration: none; }
  .mobile-menu__actions { margin-top: auto; display: flex; flex-direction: column; gap: 10px; }
  .mobile-menu__actions p { text-align: center; }

  @media (min-width: 960px) {
    .site-nav, .site-header__actions { display: flex; }
    .menu-btn, .mobile-menu { display: none !important; }
  }
  @media (min-width: 960px) and (max-width: 1100px) {
    .site-header__wa { display: none; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  }
</script>
