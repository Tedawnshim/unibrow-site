---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { lines } from '../data/site';

interface Props { project: CollectionEntry<'projects'>; eager?: boolean; }
const { project, eager = false } = Astro.props;
const d = project.data;
const meta = [d.client !== 'Unibrow Originals' ? d.client : 'Our own', d.format, d.year].filter(Boolean).join(' · ');
---
<a class="work-card" href={`/project/${project.id}/`} data-line={d.line}>
  <div class="work-card__img">
    <Image src={d.cover} alt="" widths={[400, 700, 1000]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <span class="label">{lines[d.line].label}</span>
  <span class="work-card__title">{d.title}</span>
  <span class="small">{meta}</span>
</a>
