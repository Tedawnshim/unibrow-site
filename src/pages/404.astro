---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page has moved or no longer exists." showContact={false}>
  <section class="wrap section stack" style="gap: 20px; min-height: 50vh">
    <p class="kicker">404</p>
    <h1 class="h-page">This page has wandered off.</h1>
    <p class="lead">It may have moved when we rebuilt the site. Try one of these instead.</p>
    <div class="btn-row">
      <a class="btn btn--blue" href="/">Home</a>
      <a class="btn btn--line" href="/portfolio/">Our work</a>
      <a class="btn btn--line" href="/contact/">Contact</a>
    </div>
  </section>
</Base>
