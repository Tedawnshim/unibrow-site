---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { lines } from '../data/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const counts = Object.fromEntries(Object.keys(lines).map((k) => [k, projects.filter((p) => p.data.line === k).length]));
const filters = Object.entries(lines).filter(([k]) => counts[k] > 0);
---
<Base
  title="Our work: films, content and design"
  description="Brand films, social content, design and websites by Unibrow Studio, for businesses, foundations and festivals in Manipur, the Northeast and beyond."
>
  <section class="wrap section stack" style="gap: 24px">
    <p class="kicker">Work</p>
    <h1 class="h-page">Selected work</h1>
    <p class="lead">Films, content and design for businesses, foundations and festivals, in Manipur and beyond.</p>

    <div class="filters" role="group" aria-label="Filter by service" hidden>
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {filters.map(([k, v]) => <button type="button" data-filter={k} aria-pressed="false">{v.label}</button>)}
    </div>
    <p class="small" aria-live="polite" data-count>{projects.length} projects</p>

    <div class="grid" data-grid>
      {projects.map((p, i) => <WorkCard project={p} eager={i < 3} />)}
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; }
  .filters:not([hidden]) { display: flex; }
  .filters button {
    font: 500 15px/1.2 var(--font-body); padding: 12px 16px; min-height: 44px; cursor: pointer;
    border: var(--line); background: var(--primary); color: var(--ink);
  }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--primary); }
  .grid :global(.work-card[hidden]) { display: none; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.filters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] .work-card')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (bar) {
    bar.hidden = false;
    const apply = (f: string) => {
      let n = 0;
      cards.forEach((c) => { const show = f === 'all' || c.dataset.line === f; c.hidden = !show; if (show) n++; });
      bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      if (count) count.textContent = `${n} project${n === 1 ? '' : 's'}`;
    };
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const f = b.dataset.filter!;
      apply(f);
      history.replaceState(null, '', f === 'all' ? location.pathname : `#${f}`);
    });
    const start = location.hash.slice(1);
    if (start && bar.querySelector(`[data-filter="${start}"]`)) apply(start);
  }
</script>
